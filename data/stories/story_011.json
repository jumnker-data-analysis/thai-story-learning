  "sentences": [
    {
      "id": "story_011_sentence_01",
      "th": "ผมอยู่กรุงเทพฯ",
      "en": "I live in Bangkok.",
      "zh-TW": "我住在曼谷。"
    },
    {
      "id": "story_011_sentence_02",
      "th": "บ้านของผมอยู่ใกล้สถานีรถไฟฟ้า",
      "en": "My home is near a train station.",
      "zh-TW": "我的家在捷運站附近。"
    },
    {
      "id": "story_011_sentence_03",
      "th": "แถวบ้านมีร้านอาหารหลายร้าน",
      "en": "There are many restaurants near my home.",
      "zh-TW": "我家附近有很多餐廳。"
    },
    {
      "id": "story_011_sentence_04",
      "th": "มีร้านกาแฟอยู่ข้างร้านอาหาร",
      "en": "There is a café beside a restaurant.",
      "zh-TW": "餐廳旁邊有一家咖啡店。"
    },
    {
      "id": "story_011_sentence_05",
      "th": "ตอนเช้าผมเดินไปร้านกาแฟ",
      "en": "In the morning I walk to the café.",
      "zh-TW": "早上我走去咖啡店。"
    },
    {
      "id": "story_011_sentence_06",
      "th": "ผมซื้อกาแฟหนึ่งแก้ว",
      "en": "I buy one cup of coffee.",
      "zh-TW": "我買一杯咖啡。"
    },
    {
      "id": "story_011_sentence_07",
      "th": "ตอนบ่ายผมไปเรียนภาษาไทย",
      "en": "In the afternoon I go to study Thai.",
      "zh-TW": "下午我去學泰語。"
    },
    {
      "id": "story_011_sentence_08",
      "th": "โรงเรียนอยู่ไม่ไกลจากบ้าน",
      "en": "The school is not far from home.",
      "zh-TW": "學校離家不遠。"
    },
    {
      "id": "story_011_sentence_09",
      "th": "ตอนเย็นผมกลับมากินข้าวที่บ้าน",
      "en": "In the evening I come home to eat.",
      "zh-TW": "傍晚我回家吃飯。"
    },
    {
      "id": "story_011_sentence_10",
      "th": "ผมชอบชีวิตในกรุงเทพฯ",
      "en": "I like life in Bangkok.",
      "zh-TW": "我喜歡在曼谷的生活。"
    }
  ],
  "language_notes": [
    {
      "en": "The neighborhood and school locations are fictional examples, not confirmed details of your address.",
