  "sentence_patterns": [
    {
      "id": "story_014_pattern_01",
      "name_en": "Connect a plan with a contrast",
      "pattern_th": "plan + แต่ + situation",
      "explanation_en": "แต่ means but and introduces a contrasting situation.",
      "examples": [
        {
          "th": "แต่วันนี้ฝนตก",
          "en": "But it is raining today.",
          "zh-TW": "但是今天下雨。"
        }
      ]
    },
    {
      "id": "story_014_pattern_02",
      "name_en": "Look for an object",
      "pattern_th": "subject + หา + object + location",
      "explanation_en": "หา means look for; include the search location after the object.",
      "examples": [
        {
          "th": "ผมหาร่มในบ้าน",
          "en": "I look for an umbrella in the house.",
          "zh-TW": "我在家裡找雨傘。"
        }
      ]
    },
    {
      "id": "story_014_pattern_03",
      "name_en": "Sequence two actions",
      "pattern_th": "subject + action + แล้ว + action",
      "explanation_en": "แล้ว introduces the next action.",
      "examples": [
        {
          "th": "ผมหยิบร่มแล้วใส่รองเท้า",
          "en": "I pick up the umbrella and then put on my shoes.",
          "zh-TW": "我拿起雨傘，然後穿鞋。"
        }
      ]
    }
  ],
