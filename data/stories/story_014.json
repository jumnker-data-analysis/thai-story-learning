    "th": "วันนี้ฝนตก",
    "en": "It’s Raining Today",
    "zh-TW": "今天下雨"
  },
  "content_status": "draft",
  "fictional_scenario": true,
  "learning_goals": [
    "Read 10 short Thai sentences.",
    "Review familiar words and practise seven focus entries.",
    "Use three reusable patterns.",
    "Complete four comprehension questions and three writing prompts."
  ],
  "sentences": [
    {
      "id": "story_014_sentence_01",
      "th": "ตอนเช้าผมอยากไปตลาด",
      "en": "In the morning I want to go to the market.",
      "zh-TW": "早上我想去市場。"
    },
    {
      "id": "story_014_sentence_02",
      "th": "แต่วันนี้ฝนตก",
      "en": "But it is raining today.",
      "zh-TW": "但是今天下雨。"
    },
    {
      "id": "story_014_sentence_03",
      "th": "ผมมองออกไปนอกหน้าต่าง",
      "en": "I look out of the window.",
      "zh-TW": "我望向窗外。"
    },
    {
      "id": "story_014_sentence_04",
      "th": "ถนนเปียกและมีน้ำ",
      "en": "The road is wet and there is water on it.",
      "zh-TW": "路面濕了，而且有水。"
    },
    {
      "id": "story_014_sentence_05",
      "th": "ผมหาร่มในบ้าน",
      "en": "I look for an umbrella in the house.",
      "zh-TW": "我在家裡找雨傘。"
    },
    {
      "id": "story_014_sentence_06",
      "th": "ร่มอยู่ข้างประตู",
      "en": "The umbrella is beside the door.",
      "zh-TW": "雨傘在門旁邊。"
    },
    {
      "id": "story_014_sentence_07",
      "th": "ผมหยิบร่มแล้วใส่รองเท้า",
      "en": "I pick up the umbrella and then put on my shoes.",
      "zh-TW": "我拿起雨傘，然後穿鞋。"
    },
    {
      "id": "story_014_sentence_08",
      "th": "ผมเดินไปตลาดอย่างระวัง",
      "en": "I walk carefully to the market.",
      "zh-TW": "我小心地走去市場。"
    },
    {
      "id": "story_014_sentence_09",
      "th": "หลังซื้อของฝนหยุดตก",
      "en": "After I finish shopping, it stops raining.",
      "zh-TW": "買完東西後，雨停了。"
    },
    {
      "id": "story_014_sentence_10",
      "th": "ผมกลับบ้านและเก็บร่ม",
      "en": "I return home and put away the umbrella.",
      "zh-TW": "我回家並收好雨傘。"
    }
  ],
  "language_notes": [
    {
      "en": "This is a fictional rainy-day story, not a report of current weather or road conditions.",
      "zh-TW": "這是虛構的雨天故事，不是即時天氣或路況報告。"
    },
    {
      "en": "ใส่ can mean put in or put on. With shoes in this lesson it means put on.",
      "zh-TW": "同一個詞可表示放入或穿上；本課搭配鞋子時表示穿上。"
    }
  ],
