  "title": {
    "th": "ไปตลาดกัน",
    "en": "Let’s Go to the Market",
    "zh-TW": "一起去市場吧"
  },
  "content_status": "draft",
  "fictional_scenario": true,
  "learning_goals": [
    "Read 10 short Thai sentences.",
    "Review familiar words and practise seven focus entries.",
    "Use three reusable patterns.",
    "Complete four comprehension questions and three writing prompts."
  ],
  "sentences": [
    {
      "id": "story_013_sentence_01",
      "th": "วันนี้ผมไปตลาดกับเพื่อน",
      "en": "Today I go to the market with a friend.",
      "zh-TW": "今天我和朋友去市場。"
    },
    {
      "id": "story_013_sentence_02",
      "th": "เพื่อนอยากซื้อผลไม้",
      "en": "My friend wants to buy fruit.",
      "zh-TW": "朋友想買水果。"
    },
    {
      "id": "story_013_sentence_03",
      "th": "เราเห็นส้มและกล้วย",
      "en": "We see oranges and bananas.",
      "zh-TW": "我們看到橘子和香蕉。"
    },
    {
      "id": "story_013_sentence_04",
      "th": "ผมถามว่าส้มกิโลละเท่าไรครับ",
      "en": "I ask, How much are the oranges per kilo?",
      "zh-TW": "我問：「橘子一公斤多少錢？」"
    },
    {
      "id": "story_013_sentence_05",
      "th": "แม่ค้าบอกว่ากิโลละสี่สิบบาท",
      "en": "The vendor says, Forty baht per kilo.",
      "zh-TW": "女攤販說：「一公斤四十泰銖。」"
    },
    {
      "id": "story_013_sentence_06",
      "th": "เพื่อนซื้อส้มหนึ่งกิโล",
      "en": "My friend buys one kilo of oranges.",
      "zh-TW": "朋友買一公斤橘子。"
    },
    {
      "id": "story_013_sentence_07",
      "th": "ผมซื้อผักหนึ่งถุง",
      "en": "I buy one bag of vegetables.",
      "zh-TW": "我買一袋蔬菜。"
    },
    {
      "id": "story_013_sentence_08",
      "th": "ผักถุงนี้ราคายี่สิบบาท",
      "en": "This bag of vegetables costs twenty baht.",
      "zh-TW": "這袋蔬菜二十泰銖。"
    },
    {
      "id": "story_013_sentence_09",
      "th": "เราจ่ายเงินแล้วเดินกลับบ้าน",
      "en": "We pay and then walk home.",
      "zh-TW": "我們付錢後走回家。"
    },
    {
      "id": "story_013_sentence_10",
      "th": "เราจะทำอาหารเย็นด้วยกัน",
      "en": "We will make dinner together.",
      "zh-TW": "我們要一起做晚餐。"
    }
  ],
  "language_notes": [
    {
      "en": "All prices are fictional study examples. The friend buys the oranges; the narrator buys the vegetables.",
      "zh-TW": "所有價格均為虛構學習例子。朋友買橘子，主角買蔬菜。"
    },
    {
      "en": "แม่ค้า refers to a female seller. พ่อค้า is a male seller, a supporting word for later study.",
      "zh-TW": "本課女攤販的詞可與之後學習的男攤販用詞一起比較。"
    }
  ],
