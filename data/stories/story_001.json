  "sentences": [
    {
      "id": "story_001_sentence_01",
      "th": "วันนี้ผมตื่นเช้า",
      "en": "Today I wake up early.",
      "zh-TW": "今天我很早起床。"
    },
    {
      "id": "story_001_sentence_02",
      "th": "ผมดื่มน้ำ",
      "en": "I drink water.",
      "zh-TW": "我喝水。"
    },
    {
      "id": "story_001_sentence_03",
      "th": "ผมกินอาหารเช้า",
      "en": "I eat breakfast.",
      "zh-TW": "我吃早餐。"
    },
    {
      "id": "story_001_sentence_04",
      "th": "ผมอาบน้ำและเตรียมตัว",
      "en": "I take a shower and get ready.",
      "zh-TW": "我洗澡並做準備。"
    },
    {
      "id": "story_001_sentence_05",
      "th": "ผมไปทำงาน",
      "en": "I go to work.",
      "zh-TW": "我去上班。"
    },
    {
      "id": "story_001_sentence_06",
      "th": "วันนี้ผมทำงานมาก",
      "en": "I work a lot today.",
      "zh-TW": "今天我工作很多。"
    },
    {
      "id": "story_001_sentence_07",
      "th": "ผมกลับบ้าน",
      "en": "I return home.",
      "zh-TW": "我回家。"
    },
    {
      "id": "story_001_sentence_08",
      "th": "ผมกินข้าวและนอน",
      "en": "I eat a meal and sleep.",
      "zh-TW": "我吃飯然後睡覺。"
    }
  ],
  "language_notes": [
    {
      "en": "Thai verbs do not change form for tense. Time words and context help indicate when an action happens.",
      "zh-TW": "泰語動詞不會因時態而改變形式。時間詞和上下文可幫助判斷動作發生的時間。"
    }
  ],
