  "sentence_patterns": [
    {
      "id": "story_001_pattern_01",
      "name_en": "Subject + verb + object",
      "pattern_th": "ผม + verb + object",
      "explanation_en": "Say what you do using a subject, an action, and an object.",
      "examples": [
        {
          "th": "ผมดื่มน้ำ",
          "en": "I drink water.",
          "zh-TW": "我喝水。"
        },
        {
          "th": "ผมกินข้าว",
          "en": "I eat a meal.",
          "zh-TW": "我吃飯。"
        }
      ]
    },
    {
      "id": "story_001_pattern_02",
      "name_en": "Time + subject + action",
      "pattern_th": "วันนี้ + ผม + action",
      "explanation_en": "Place วันนี้ before the subject to say what you do today.",
      "examples": [
        {
          "th": "วันนี้ผมทำงาน",
          "en": "Today I work.",
          "zh-TW": "今天我上班。"
        },
        {
          "th": "วันนี้ผมไปทำงาน",
          "en": "Today I go to work.",
          "zh-TW": "今天我去上班。"
        }
      ]
    },
    {
      "id": "story_001_pattern_03",
      "name_en": "Connect two actions",
      "pattern_th": "ผม + action + และ + action",
      "explanation_en": "และ connects actions or ideas. It means and. Learn แล้ว for explicit sequencing in a later lesson.",
      "examples": [
        {
          "th": "ผมกินข้าวและนอน",
          "en": "I eat a meal and sleep.",
          "zh-TW": "我吃飯並睡覺。"
        },
        {
          "th": "ผมอาบน้ำและเตรียมตัว",
          "en": "I take a shower and get ready.",
          "zh-TW": "我洗澡並做準備。"
        }
      ]
    }
  ],
