    "notes": [
      {
        "id": "story_001_reading_01",
        "th": "ผม",
        "school_reading": "phǒm",
        "note_en": "High-class ผ, live syllable, no tone mark: rising tone."
      },
      {
        "id": "story_001_reading_02",
        "th": "วันนี้",
        "school_reading": "wan-níi",
        "note_en": "Two syllables. นี้ has a high tone."
      },
      {
        "id": "story_001_reading_03",
        "th": "น้ำ",
        "school_reading": "náam",
        "note_en": "High tone. Learn its pronunciation alongside its special vowel spelling."
      },
      {
        "id": "story_001_reading_04",
        "th": "กิน",
        "school_reading": "kin",
        "note_en": "Middle-class ก, live syllable, no tone mark: mid tone. Use k for ก."
      },
      {
        "id": "story_001_reading_05",
        "th": "ดื่ม",
        "school_reading": "dʉ̀ʉm",
        "note_en": "Middle-class ด with ่: low tone."
      },
      {
        "id": "story_001_reading_06",
        "th": "เช้า",
        "school_reading": "cháao",
        "note_en": "Low-class ช with ้: high tone."
      },
      {
        "id": "story_001_reading_07",
        "th": "ไป",
        "school_reading": "pai",
        "note_en": "Middle-class ป, live syllable, no tone mark: mid tone."
      },
      {
        "id": "story_001_reading_08",
        "th": "ทำงาน",
        "school_reading": "tham-ŋaan",
        "note_en": "Two syllables. ง is represented by ŋ."
      },
      {
        "id": "story_001_reading_09",
        "th": "กลับ",
        "school_reading": "klàp",
        "note_en": "Middle-class ก with a short dead syllable: low tone. Final บ sounds like p."
      },
      {
        "id": "story_001_reading_10",
        "th": "บ้าน",
        "school_reading": "bâan",
        "note_en": "Middle-class บ with ้: falling tone."
      },
      {
        "id": "story_001_reading_11",
        "th": "นอน",
        "school_reading": "nɔɔn",
        "note_en": "Low-class น, live syllable, no tone mark: mid tone."
      }
    ]
