  "sentences": [
    {
      "id": "story_010_sentence_01",
      "th": "วันนี้ร้านยุ่งมาก",
      "en": "The restaurant is very busy today.",
      "zh-TW": "今天餐廳非常忙。"
    },
    {
      "id": "story_010_sentence_02",
      "th": "ตอนเที่ยงมีลูกค้าหลายคน",
      "en": "At noon there are many customers.",
      "zh-TW": "中午有很多客人。"
    },
    {
      "id": "story_010_sentence_03",
      "th": "ลูกค้าบางคนรอโต๊ะ",
      "en": "Some customers wait for a table.",
      "zh-TW": "有些客人在等桌位。"
    },
    {
      "id": "story_010_sentence_04",
      "th": "ผมเดินไปมาระหว่างโต๊ะ",
      "en": "I walk back and forth between the tables.",
      "zh-TW": "我在桌子之間來回走動。"
    },
    {
      "id": "story_010_sentence_05",
      "th": "ผมนำอาหารไปให้ลูกค้า",
      "en": "I take food to the customers.",
      "zh-TW": "我把食物送給客人。"
    },
    {
      "id": "story_010_sentence_06",
      "th": "เพื่อนร่วมงานช่วยเก็บจาน",
      "en": "My coworker helps clear the plates.",
      "zh-TW": "同事幫忙收盤子。"
    },
    {
      "id": "story_010_sentence_07",
      "th": "เราทำงานเร็วแต่ระวัง",
      "en": "We work quickly but carefully.",
      "zh-TW": "我們動作很快，但仍小心。"
    },
    {
      "id": "story_010_sentence_08",
      "th": "ผมเหนื่อยและหิวน้ำ",
      "en": "I am tired and thirsty.",
      "zh-TW": "我很累，也很渴。"
    },
    {
      "id": "story_010_sentence_09",
      "th": "ตอนบ่ายลูกค้าน้อยลง",
      "en": "In the afternoon there are fewer customers.",
      "zh-TW": "下午客人變少了。"
    },
    {
      "id": "story_010_sentence_10",
      "th": "ผมได้นั่งพักและดื่มน้ำ",
      "en": "I get to sit down, rest, and drink water.",
      "zh-TW": "我終於能坐下休息並喝水。"
    }
  ],
  "language_notes": [
    {
      "en": "This is a fictional shift. The story moves from a busy noon to a quieter afternoon.",
      "zh-TW": "這是虛構的班次，故事從忙碌的中午進展到較清閒的下午。"
    },
    {
      "en": "ได้ before an action can mean get to do it. Here it describes having an opportunity to rest.",
      "zh-TW": "放在動作前的詞在此表示有機會做某事，也就是能休息了。"
    }
  ],
